APP_ENV=local
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Bangkok

# SQLite database path
DB_PATH=storage/app.db

# Phase 2 upload settings
UPLOAD_MAX_MB=500

# Keep empty until later phases.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

ZERNIO_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=personal-poster
R2_PUBLIC_BASE_URL=

# Optional admin lock.
# Leave ADMIN_PASSWORD_HASH empty while developing locally.
# Before exposing with Cloudflare Tunnel, run:
# php bin/hash-password.php "your-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
